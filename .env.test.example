# ============================================
# NEXT-MONARCA — Test Environment Variables
# ============================================
# Copy this file to .env.test and fill in your test database credentials.
# NEVER commit .env.test to git — it contains secrets.

# Test database (must be separate from production)
# Example: local Supabase or dedicated test project
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase (test project)
NEXT_PUBLIC_SUPABASE_URL="https://your-test-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-test-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-test-service-role-key"

# Optional: override base URL for E2E tests
TEST_BASE_URL="http://localhost:3000"

# R2 (can be dummy values if tests don't hit R2)
R2_ACCOUNT_ID="test"
R2_ACCESS_KEY_ID="test"
R2_SECRET_ACCESS_KEY="test"
R2_BUCKET_NAME="test"
R2_PUBLIC_URL="https://test.example.com"

# Brevo (can be dummy if tests don't send real emails)
BREVO_API_KEY="test"

# OneSignal (can be dummy)
NEXT_PUBLIC_ONESIGNAL_APP_ID="test"
ONESIGNAL_REST_API_KEY="test"

# Sentry — disabled in tests to avoid noise
NEXT_PUBLIC_SENTRY_DSN=
